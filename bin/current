#!/bin/sh
# Launches Current. Installed: /usr/lib/current/current. From a checkout: the bundled Electron in node_modules.
HERE="$(dirname "$(readlink -f "$0")")"
if [ -x "$HERE/../lib/current/current" ]; then
    exec "$HERE/../lib/current/current" "$@"
fi
ROOT="$HERE/.."
exec "$ROOT/node_modules/electron/dist/electron" "$ROOT" "$@"
