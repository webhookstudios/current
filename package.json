{
  "name": "current",
  "productName": "Current",
  "version": "1.6.0",
  "description": "A template-rich video editor for Ubuntu",
  "main": "main.js",
  "desktopName": "io.github.webhookstudios.Current.desktop",
  "license": "GPL-2.0-or-later",
  "author": "webhookstudios",
  "homepage": "https://github.com/webhookstudios/current",
  "scripts": {
    "start": "electron .",
    "test": "electron . --selftest=tests/smoke.js",
    "deb": "./build-deb.sh",
    "mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "io.github.webhookstudios.Current",
    "productName": "Current",
    "copyright": "webhookstudios",
    "files": [
      "package.json",
      "main.js",
      "encoder.js",
      "preload.js",
      "src/**/*",
      "data/io.github.webhookstudios.Current.png"
    ],
    "extraResources": [
      {
        "from": "vendor/mac/ffmpeg",
        "to": "bin/ffmpeg"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Current uses the microphone to record voiceovers.",
        "NSCameraUsageDescription": "Current uses the camera to record webcam clips.",
        "NSScreenCaptureUsageDescription": "Current records your screen when you ask it to."
      },
      "fileAssociations": [
        {
          "ext": "splice",
          "name": "Current project",
          "role": "Editor"
        }
      ]
    },
    "dmg": {
      "title": "Current"
    }
  }
}
